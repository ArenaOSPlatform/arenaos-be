DATABASE_URL="postgresql://user:password@host:5432/arenaos"
# Required for npm run test:e2e. Use an isolated database, never the development or production DB.
TEST_DATABASE_URL="postgresql://arenaos:arenaos@localhost:5433/arenaos_test"
# Optional CI-only override for disposable databases whose name does not contain "test".
E2E_ALLOW_NON_TEST_DATABASE=false

JWT_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
NODE_ENV="development"
PORT=3000
CORS_ORIGINS="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="google-oauth-client-id.apps.googleusercontent.com"

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user-or-email"
SMTP_PASS="smtp-password-or-app-password"
SMTP_FROM="ArenaOS <no-reply@arenaos.com>"
SMTP_REQUIRE_CONFIG=false
PASSWORD_RESET_OTP_TTL_MINUTES=10

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Optional production upload provider. If unset, /uploads falls back to local disk.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# Or use the split variables below instead of CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME="cloud-name"
CLOUDINARY_API_KEY="cloudinary-api-key"
CLOUDINARY_API_SECRET="cloudinary-api-secret"
CLOUDINARY_UPLOAD_FOLDER="arenaos"
UPLOAD_REQUIRE_CLOUDINARY=false

# Swagger is disabled by default in production.
ENABLE_SWAGGER=false
